# ==============================================================================
# Moody Blues - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Gateway & Ingress Configuration
# ------------------------------------------------------------------------------
# Root public or local domain used for reverse proxy routing and automated TLS
DOMAIN=example.com

# ------------------------------------------------------------------------------
# Storage & Virtual Filesystem (Real-Debrid + Zurg + Rclone)
# ------------------------------------------------------------------------------
# Real-Debrid API private token (obtain from https://real-debrid.com/apitoken)
RD_API_TOKEN=your-real-debrid-api-token
# Host path where Zurg/rclone mounts the raw Real-Debrid virtual filesystem (read-only FUSE)
ZURG_MOUNT_PATH=/mnt/zurg
# Host path for the organized media library (writable; contains symlinks into ZURG_MOUNT_PATH)
MEDIA_PATH=/mnt/media
# Linux user and group ID for filesystem permissions
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# Streaming & Media Delivery (Jellyfin + Jellyseerr)
# ------------------------------------------------------------------------------
# Public domain or subdomain for media streaming core (Jellyfin)
# Optional: Defaults to jellyfin.${DOMAIN} (e.g. jellyfin.example.com) if omitted
# JELLYFIN_DOMAIN=jellyfin.example.com
# Public domain or subdomain for media discovery and request portal (Jellyseerr)
# Optional: Defaults to jellyseerr.${DOMAIN} (e.g. jellyseerr.example.com) if omitted
# JELLYSEERR_DOMAIN=jellyseerr.example.com

# ------------------------------------------------------------------------------
# Media Automation & Indexing (Sonarr + Radarr + Prowlarr)
# ------------------------------------------------------------------------------
# Public domains or subdomains for media management dashboards
# Optional: Defaults to <service>.${DOMAIN} (e.g. sonarr.example.com) if omitted
# SONARR_DOMAIN=sonarr.example.com
# RADARR_DOMAIN=radarr.example.com
# PROWLARR_DOMAIN=prowlarr.example.com

# ------------------------------------------------------------------------------
# CI/CD Deployment Secrets (GitHub Repository Secrets)
# ------------------------------------------------------------------------------
# Required for automated deployment via GitHub Actions (.github/workflows/deploy.yml)
# Configure these in: GitHub Repository -> Settings -> Secrets and variables -> Actions
# SSH_HOST=your-server-ip-or-hostname
# SSH_USER=deploy-user
# SSH_PORT=22
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"
